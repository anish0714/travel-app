PORT=4000

# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-random-secret"

# Local dev (installed via winget, superuser password set to "postgres")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelapp?schema=public"

# Neon (production) — replace with the connection string from your Neon project
# DATABASE_URL="postgresql://<user>:<password>@<endpoint>.neon.tech/travelapp?sslmode=require"
